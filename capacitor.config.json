{
  "appId": "com.legend.game",
  "appName": "LEGEND",
  "webDir": "www",
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0b0d12",
    "minSdkVersion": 23,
    "targetSdkVersion": 35,
    "buildOptions": { "releaseType": "APK" }
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0b0d12"
  },
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["*"]
  },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 800, "backgroundColor": "#0b0d12" }
  }
}
